<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Myelin.UI.ViewModels"
        xmlns:views="using:Myelin.UI.Views"
        xmlns:models="using:Myelin.Core.Models"
        xmlns:services="using:Myelin.Core.Services"
        x:Name="MainWindowRoot"
        x:Class="Myelin.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Myelin IDE"
        Width="1340" Height="860"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="35"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{StaticResource EditorBackgroundBrush}"
        Foreground="{StaticResource EditorForegroundBrush}">

    <!-- Global VS Code Shortcut Key Bindings -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenQuickFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+J" Command="{Binding ToggleTerminalCommand}" />
        <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding ToggleTerminalCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+OemTilde" Command="{Binding BottomPanel.CreateTerminalTabCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCurrentCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewFileCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCurrentCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCurrentCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding RunCargoTaskCommand}" CommandParameter="build" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding SelectActivityCommand}" CommandParameter="5" />
        <KeyBinding Gesture="F5" Command="{Binding Debug.StartDebuggingCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding Debug.StopCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F5" Command="{Binding Debug.RestartCommand}" />
        <KeyBinding Gesture="F10" Command="{Binding Debug.StepOverCommand}" />
        <KeyBinding Gesture="F11" Command="{Binding Debug.StepIntoCommand}" />
        <KeyBinding Gesture="Shift+F11" Command="{Binding Debug.StepOutCommand}" />
    </Window.KeyBindings>

    <Grid x:Name="MainRootGrid">
        <!-- Main VS Code Workbench Layout (TitleBar, Body, StatusBar) -->
        <Grid RowDefinitions="35,*,22">
            
            <!-- ========================================================================= -->
            <!-- 1. CUSTOM VS CODE TITLE BAR & MENUS & COMMAND CENTER (35px)               -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0" 
                    Background="{StaticResource TitleBarBackgroundBrush}" 
                    BorderThickness="0"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- Left: App Icon & Menu Bar Directly in the Title Bar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Path Data="{StaticResource IconCommand}" Width="15" Height="15" Fill="#0078D4" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Menu Background="Transparent" Foreground="{StaticResource TitleBarForegroundBrush}">
                            <MenuItem Header="_File">
                                <MenuItem Header="_New Text File" Command="{Binding NewFileCommand}" InputGesture="Ctrl+N" />
                                <MenuItem Header="_New Window" Click="OnNewWindowClick" InputGesture="Ctrl+Shift+N" />
                                <Separator />
                                <MenuItem Header="_Open File..." Click="OnOpenFileClick" InputGesture="Ctrl+O" />
                                <MenuItem Header="_Open Folder..." Click="OnOpenFolderClick" InputGesture="Ctrl+Shift+O" />
                                <Separator />
                                <MenuItem Header="_Save" Command="{Binding SaveCurrentCommand}" InputGesture="Ctrl+S" />
                                <MenuItem Header="Save _As..." Click="OnSaveAsClick" InputGesture="Ctrl+Shift+S" />
                                <MenuItem Header="Save A_ll" Click="OnSaveAllClick" />
                                <Separator />
                                <MenuItem Header="_Close Editor" Click="OnCloseCurrentTabClick" InputGesture="Ctrl+W" />
                                <MenuItem Header="Close A_ll Editors" Click="OnCloseAllTabsClick" InputGesture="Ctrl+Shift+W" />
                                <MenuItem Header="Close _Folder" Click="OnCloseFolderClick" />
                                <Separator />
                                <MenuItem Header="E_xit" Click="OnExitClick" InputGesture="Alt+F4" />
                            </MenuItem>
                            <MenuItem Header="_Edit">
                                <MenuItem Header="_Undo" Command="{Binding UndoCurrentCommand}" InputGesture="Ctrl+Z" />
                                <MenuItem Header="_Redo" Command="{Binding RedoCurrentCommand}" InputGesture="Ctrl+Y" />
                                <Separator />
                                <MenuItem Header="Cu_t" Click="OnCutClick" InputGesture="Ctrl+X" />
                                <MenuItem Header="_Copy" Click="OnCopyClick" InputGesture="Ctrl+C" />
                                <MenuItem Header="_Paste" Click="OnPasteClick" InputGesture="Ctrl+V" />
                                <Separator />
                                <MenuItem Header="_Find in Files" Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+Shift+F" />
                            </MenuItem>
                            <MenuItem Header="_Selection">
                                <MenuItem Header="_Select All" Click="OnSelectAllClick" InputGesture="Ctrl+A" />
                                <MenuItem Header="_Expand Selection" Click="OnExpandSelectionClick" InputGesture="Shift+Alt+Right" />
                                <MenuItem Header="_Shrink Selection" Click="OnShrinkSelectionClick" InputGesture="Shift+Alt+Left" />
                                <Separator />
                                <MenuItem Header="Copy Line _Up" Click="OnCopyLineUpClick" InputGesture="Shift+Alt+Up" />
                                <MenuItem Header="Copy Line _Down" Click="OnCopyLineDownClick" InputGesture="Shift+Alt+Down" />
                                <MenuItem Header="Move Line U_p" Click="OnMoveLineUpClick" InputGesture="Alt+Up" />
                                <MenuItem Header="Move Line D_own" Click="OnMoveLineDownClick" InputGesture="Alt+Down" />
                            </MenuItem>
                            <MenuItem Header="_View">
                                <MenuItem Header="_Command Palette..." Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+Shift+P" />
                                <MenuItem Header="_Open View..." Command="{Binding OpenQuickFileCommand}" />
                                <Separator />
                                <MenuItem Header="_Appearance">
                                    <MenuItem Header="_Toggle Primary Side Bar" Command="{Binding ToggleSidebarCommand}" InputGesture="Ctrl+B" />
                                    <MenuItem Header="_Toggle Panel" Click="OnToggleTerminalClick" InputGesture="Ctrl+J" />
                                    <MenuItem Header="_Toggle Full Screen" Click="OnToggleFullScreenClick" InputGesture="F11" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="_Explorer" Command="{Binding SelectActivityCommand}" CommandParameter="0" InputGesture="Ctrl+Shift+E" />
                                <MenuItem Header="_Search" Command="{Binding SelectActivityCommand}" CommandParameter="1" InputGesture="Ctrl+Shift+F" />
                                <MenuItem Header="_Source Control" Command="{Binding SelectActivityCommand}" CommandParameter="2" InputGesture="Ctrl+Shift+G" />
                                <Separator />
                                <MenuItem Header="_Problems" Click="OnProblemsTabClick" InputGesture="Ctrl+Shift+M" />
                                <MenuItem Header="_Output" Click="OnOutputTabClick" />
                                <MenuItem Header="_Terminal" Click="OnTerminalTabClick" InputGesture="Ctrl+J" />
                            </MenuItem>
                            <MenuItem Header="_Go">
                                <MenuItem Header="_Go to File..." Command="{Binding OpenQuickFileCommand}" InputGesture="Ctrl+P" />
                                <MenuItem Header="_Go to Symbol..." Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+T" />
                                <Separator />
                                <MenuItem Header="_Next Problem" Click="OnNextProblemClick" InputGesture="F8" />
                                <MenuItem Header="_Previous Problem" Click="OnPreviousProblemClick" InputGesture="Shift+F8" />
                            </MenuItem>
                            <MenuItem Header="_Run">
                                <MenuItem Header="_Start Debugging / Run" Click="OnCargoRunClick" InputGesture="F5" />
                                <MenuItem Header="_Run Without Debugging" Click="OnCargoRunClick" InputGesture="Ctrl+F5" />
                                <Separator />
                                <MenuItem Header="_Cargo Build Workspace" Click="OnCargoBuildClick" InputGesture="Ctrl+Shift+B" />
                                <MenuItem Header="_Cargo Check Workspace" Click="OnCargoCheckClick" />
                                <MenuItem Header="_Cargo Test Workspace" Click="OnCargoTestClick" />
                                <MenuItem Header="_Cargo Clean Workspace" Click="OnCargoCleanClick" />
                            </MenuItem>
                            <MenuItem Header="_Terminal">
                                <MenuItem Header="_New Terminal" Click="OnTerminalTabClick" InputGesture="Ctrl+J" />
                                <MenuItem Header="_Run Build Task..." Click="OnCargoBuildClick" InputGesture="Ctrl+Shift+B" />
                                <Separator />
                                <MenuItem Header="_Clear Terminal" Click="OnClearTerminalClick" InputGesture="Ctrl+K" />
                            </MenuItem>
                            <MenuItem Header="_Help">
                                <MenuItem Header="_Welcome" Click="OnWelcomeClick" />
                                <MenuItem Header="_Documentation" Click="OnDocumentationClick" />
                                <MenuItem Header="_Show All Commands" Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+Shift+P" />
                                <Separator />
                                <MenuItem Header="_About Myelin IDE" Click="OnAboutClick" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Center: VS Code Command Center Search Pill (460px) -->
                    <Button Grid.Column="1" 
                            Width="460" Height="24" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Background="{StaticResource CommandCenterBackgroundBrush}" 
                            BorderBrush="{StaticResource CommandCenterBorderBrush}" 
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,0"
                            Command="{Binding OpenQuickFileCommand}"
                            ToolTip.Tip="Search files and commands (Ctrl+P)">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkspaceName, StringFormat='{}{0} — Search files and commands (Ctrl+P)'}" 
                                       FontSize="12" Foreground="#858585" VerticalAlignment="Center" TextAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Right: Quick Layout Buttons + Window Controls (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
                        <Button Background="Transparent" Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle Primary Side Bar (Ctrl+B)">
                            <Path Data="{StaticResource IconExplorer}" Width="13" Height="13" Fill="#858585" Stretch="Uniform" />
                        </Button>
                        <Button Background="Transparent" Padding="8,4" VerticalAlignment="Center" Margin="0,0,10,0" Click="OnToggleTerminalClick" ToolTip.Tip="Toggle Panel (Ctrl+J)">
                            <Path Data="{StaticResource IconTerminal}" Width="13" Height="13" Fill="#858585" Stretch="Uniform" />
                        </Button>

                        <!-- Window Control Buttons -->
                        <!-- Minimize Button -->
                        <Button Width="46" Height="35" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                            <Path Data="M0,0 H10" Stroke="#CCCCCC" StrokeThickness="1" Width="10" Height="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button Width="46" Height="35" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="OnMaximizeClick" ToolTip.Tip="Maximize">
                            <Rectangle Width="10" Height="10" Stroke="#CCCCCC" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <!-- Close Button with VS Code Red Hover -->
                        <Button Width="46" Height="35" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="OnCloseWindowClick" ToolTip.Tip="Close">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#E81123" />
                                </Style>
                            </Button.Styles>
                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Fill="#CCCCCC" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- ========================================================================= -->
            <!-- 2. WORKBENCH BODY (ActivityBar + SideBar + Resizer Splitter + Editor Area) -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Activity Bar (48px) -->
                    <ColumnDefinition Width="48" />
                    <!-- Column 1: Primary SideBar (Resizable) -->
                    <ColumnDefinition Width="{Binding IsSidebarOpen, Converter={x:Static views:SidebarColumnWidthConverter.Instance}}" MinWidth="0" MaxWidth="800" />
                    <!-- Column 2: Resizer Splitter Handle between SideBar and Editor Area -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Column 3: Editor + Bottom Dock Region (*) -->
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>
                
                <!-- 2.1 Activity Bar (48px Left Rail with 2px Active Indicator) -->
                <Border Grid.Column="0" 
                        Background="{StaticResource ActivityBarBackgroundBrush}" 
                        BorderBrush="{StaticResource ActivityBarBorderBrush}" 
                        BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <!-- Top Navigation Group -->
                        <StackPanel DockPanel.Dock="Top">
                            <!-- Explorer -->
                            <Grid Height="48">
                                <Border HorizontalAlignment="Left" Width="2" 
                                        Background="{Binding ActiveActivityIndex, Converter={x:Static views:ActiveBorderConverter.Instance}, ConverterParameter=0}" />
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Command="{Binding SelectActivityCommand}"
                                        CommandParameter="0"
                                        ToolTip.Tip="Explorer (Ctrl+Shift+E)">
                                    <Path Data="{StaticResource IconExplorer}" 
                                          Width="20" Height="20" 
                                          Fill="{Binding ActiveActivityIndex, Converter={x:Static views:ActivityColorConverter.Instance}, ConverterParameter=0}" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Search -->
                            <Grid Height="48">
                                <Border HorizontalAlignment="Left" Width="2" 
                                        Background="{Binding ActiveActivityIndex, Converter={x:Static views:ActiveBorderConverter.Instance}, ConverterParameter=1}" />
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Command="{Binding SelectActivityCommand}"
                                        CommandParameter="1"
                                        ToolTip.Tip="Search (Ctrl+Shift+F)">
                                    <Path Data="{StaticResource IconSearch}" 
                                          Width="20" Height="20" 
                                          Fill="{Binding ActiveActivityIndex, Converter={x:Static views:ActivityColorConverter.Instance}, ConverterParameter=1}" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Source Control (with Live Changes Badge) -->
                            <Grid Height="48">
                                <Border HorizontalAlignment="Left" Width="2" 
                                        Background="{Binding ActiveActivityIndex, Converter={x:Static views:ActiveBorderConverter.Instance}, ConverterParameter=2}" />
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Command="{Binding SelectActivityCommand}"
                                        CommandParameter="2"
                                        ToolTip.Tip="Source Control (Ctrl+Shift+G)">
                                    <Grid>
                                        <Path Data="{StaticResource IconSourceControl}" 
                                              Width="20" Height="20" 
                                              Fill="{Binding ActiveActivityIndex, Converter={x:Static views:ActivityColorConverter.Instance}, ConverterParameter=2}" 
                                              Stretch="Uniform" />
                                        <!-- Changes Badge -->
                                        <Border IsVisible="{Binding SourceControl.HasChanges}"
                                                Background="#0078D4" CornerRadius="8"
                                                Height="15" MinWidth="15" Padding="4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-4,-8,0">
                                            <TextBlock Text="{Binding SourceControl.TotalChangesCount}" 
                                                       FontSize="9" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Run and Debug -->
                            <Grid Height="48">
                                <Border HorizontalAlignment="Left" Width="2" 
                                        Background="{Binding ActiveActivityIndex, Converter={x:Static views:ActiveBorderConverter.Instance}, ConverterParameter=5}" />
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Command="{Binding SelectActivityCommand}"
                                        CommandParameter="5"
                                        ToolTip.Tip="Run and Debug (Ctrl+Shift+D)">
                                    <Path Data="{StaticResource IconDebug}" 
                                          Width="20" Height="20" 
                                          Fill="{Binding ActiveActivityIndex, Converter={x:Static views:ActivityColorConverter.Instance}, ConverterParameter=5}" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Remote Explorer -->
                            <Grid Height="48">
                                <Border HorizontalAlignment="Left" Width="2" 
                                        Background="{Binding ActiveActivityIndex, Converter={x:Static views:ActiveBorderConverter.Instance}, ConverterParameter=6}" />
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Command="{Binding SelectActivityCommand}"
                                        CommandParameter="6"
                                        ToolTip.Tip="Remote Explorer">
                                    <Path Data="{StaticResource IconRemoteExplorer}" 
                                          Width="20" Height="20" 
                                          Fill="{Binding ActiveActivityIndex, Converter={x:Static views:ActivityColorConverter.Instance}, ConverterParameter=6}" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Extensions -->
                            <Grid Height="48">
                                <Border HorizontalAlignment="Left" Width="2" 
                                        Background="{Binding ActiveActivityIndex, Converter={x:Static views:ActiveBorderConverter.Instance}, ConverterParameter=4}" />
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Command="{Binding SelectActivityCommand}"
                                        CommandParameter="4"
                                        ToolTip.Tip="Extensions (Ctrl+Shift+X)">
                                    <Path Data="{StaticResource IconExtensions}" 
                                          Width="20" Height="20" 
                                          Fill="{Binding ActiveActivityIndex, Converter={x:Static views:ActivityColorConverter.Instance}, ConverterParameter=4}" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Bottom Group: Accounts + Settings -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <!-- Accounts / Profile -->
                            <Grid Height="48">
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        ToolTip.Tip="Accounts">
                                    <Path Data="{StaticResource IconAccount}" 
                                          Width="20" Height="20" 
                                          Fill="#858585" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Settings Gear -->
                            <Grid Height="48">
                                <Border HorizontalAlignment="Left" Width="2" 
                                        Background="{Binding ActiveActivityIndex, Converter={x:Static views:ActiveBorderConverter.Instance}, ConverterParameter=3}" />
                                <Button Background="Transparent" 
                                        Width="48" Height="48"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Command="{Binding SelectActivityCommand}"
                                        CommandParameter="3"
                                        ToolTip.Tip="Settings (Ctrl+,)">
                                    <Path Data="{StaticResource IconSettings}" 
                                          Width="20" Height="20" 
                                          Fill="{Binding ActiveActivityIndex, Converter={x:Static views:ActivityColorConverter.Instance}, ConverterParameter=3}" 
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 2.2 Primary Side Bar (Takes 100% of Column 1) -->
                <Border Grid.Column="1" 
                        Background="{StaticResource SideBarBackgroundBrush}"
                        IsVisible="{Binding IsSidebarOpen}"
                        HorizontalAlignment="Stretch"
                        MinWidth="160"
                        MaxWidth="800">
                    <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- ============================================================= -->
                        <!-- 0: EXPLORER VIEW                                              -->
                        <!-- ============================================================= -->
                        <Grid RowDefinitions="35,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ActiveActivityIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=0}">
                            <!-- Header (35px) -->
                            <Border Grid.Row="0" Height="35" Padding="14,0,8,0" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{Binding WorkspaceName, StringFormat='EXPLORER: {0}'}" 
                                               FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SideBarHeaderForegroundBrush}" VerticalAlignment="Center" />
                                    <!-- Action Toolbar with Codicons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Background="Transparent" Width="22" Height="22" Padding="3" BorderThickness="0" CornerRadius="3" Command="{Binding CreateFileCommand}" ToolTip.Tip="New File...">
                                            <Path Data="{StaticResource IconNewFile}" Width="14" Height="14" Fill="#CCCCCC" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Background="Transparent" Width="22" Height="22" Padding="3" BorderThickness="0" CornerRadius="3" Command="{Binding CreateFolderCommand}" ToolTip.Tip="New Folder...">
                                            <Path Data="{StaticResource IconNewFolder}" Width="14" Height="14" Fill="#CCCCCC" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Background="Transparent" Width="22" Height="22" Padding="3" BorderThickness="0" CornerRadius="3" Command="{Binding RefreshExplorerCommand}" ToolTip.Tip="Refresh Explorer">
                                            <Path Data="{StaticResource IconRefresh}" Width="14" Height="14" Fill="#CCCCCC" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Background="Transparent" Width="22" Height="22" Padding="3" BorderThickness="0" CornerRadius="3" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse All Folders">
                                            <Path Data="{StaticResource IconCollapseAll}" Width="14" Height="14" Fill="#CCCCCC" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Explorer Content (Open Editors + Folders) -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                                    <!-- Open Editors Section Header -->
                                    <Border Height="22" Background="{StaticResource SideBarSectionHeaderBackgroundBrush}" Padding="8,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="#CCCCCC" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="OPEN EDITORS" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tabs.Count}" FontSize="10" Foreground="#888888" VerticalAlignment="Center" />
                                                <Button Background="Transparent" Padding="2" BorderThickness="0" Command="{Binding CloseAllTabsCommand}" ToolTip.Tip="Close All Editors" IsVisible="{Binding Tabs.Count}">
                                                    <Path Data="{StaticResource IconClose}" Width="7" Height="7" Fill="#858585" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Open Editors List -->
                                    <ItemsControl ItemsSource="{Binding Tabs}" Margin="0,2,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
                                                <Button Background="{Binding IsSelected, Converter={x:Static views:TabBackgroundConverter.Instance}}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Padding="12,3" BorderThickness="0"
                                                        Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).SelectTabCommand}"
                                                        CommandParameter="{Binding}"
                                                        PointerPressed="OnOpenEditorItemPointerPressed">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Image Grid.Column="0" Source="{Binding FilePath, Converter={x:Static views:MaterialIconImageConverter.Instance}}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#EBCB8B" IsVisible="{Binding IsDirty}" Margin="4,0" VerticalAlignment="Center" />
                                                        <Button Grid.Column="3" Background="Transparent" Padding="2" BorderThickness="0"
                                                                Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Close Tab">
                                                            <Path Data="{StaticResource IconClose}" Width="7" Height="7" Fill="#858585" Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Folders Section Header -->
                                    <Border Height="22" Background="{StaticResource SideBarSectionHeaderBackgroundBrush}" Padding="8,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Fill="#CCCCCC" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding WorkspaceName, FallbackValue='FOLDERS'}" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Empty Workspace State -->
                                    <StackPanel IsVisible="{Binding RootNode, Converter={x:Static ObjectConverters.IsNull}}" Margin="16" Spacing="10" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFolder}" Width="32" Height="32" Fill="#555555" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock Text="You have not yet opened a folder." FontSize="12" Foreground="#888888" TextAlignment="Center" TextWrapping="Wrap" />
                                        <Button Background="#0078D4" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,6" CornerRadius="3"
                                                Command="{Binding OpenFolderPromptCommand}">
                                            <TextBlock Text="Open Folder" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Background="#2A2A2A" Foreground="#CCCCCC" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,6" CornerRadius="3"
                                                Command="{Binding OpenFilePromptCommand}">
                                            <TextBlock Text="Open File" FontSize="12" />
                                        </Button>
                                        <Button Background="Transparent" Foreground="#75BEFF" HorizontalAlignment="Center" BorderThickness="0"
                                                Command="{Binding CreateFileCommand}">
                                            <TextBlock Text="New Text File" FontSize="12" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Folder File Tree (Philipp Kief Material Icon Theme + Context Menu) -->
                                    <TreeView ItemsSource="{Binding RootNode.Children}"
                                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                              SelectionChanged="OnFileSelected"
                                              Background="Transparent"
                                              Margin="2,2"
                                              IsVisible="{Binding RootNode, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TreeView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="New File..." Command="{Binding CreateFileCommand}" CommandParameter="{Binding SelectedNode}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource IconNewFile}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="New Folder..." Command="{Binding CreateFolderCommand}" CommandParameter="{Binding SelectedNode}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource IconNewFolder}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Reveal in File Explorer" Command="{Binding RevealInExplorerCommand}" CommandParameter="{Binding SelectedNode}" />
                                                <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedNode}" />
                                                <MenuItem Header="Copy Relative Path" Command="{Binding CopyRelativePathCommand}" CommandParameter="{Binding SelectedNode}" />
                                                <Separator />
                                                <MenuItem Header="Delete" Command="{Binding DeleteNodeCommand}" CommandParameter="{Binding SelectedNode}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource IconTrash}" Width="12" Height="12" Fill="#F14C4C" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Refresh" Command="{Binding RefreshExplorerCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TreeView.ContextMenu>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate DataType="{x:Type models:FileNode}" ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="Auto,*" Height="22" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                    <Image Grid.Column="0" Source="{Binding Converter={x:Static views:MaterialIconImageConverter.Instance}}" 
                                                           Width="16" Height="16" Margin="0,0,6,0"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============================================================= -->
                        <!-- 1: SEARCH VIEW                                                -->
                        <!-- ============================================================= -->
                        <Grid RowDefinitions="35,Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ActiveActivityIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=1}">
                            <!-- Header (35px) -->
                            <Border Grid.Row="0" Height="35" Padding="14,0,8,0" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="SEARCH" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SideBarHeaderForegroundBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <Button Background="Transparent" Padding="4" Command="{Binding Search.SearchCommand}" ToolTip.Tip="Refresh Search">
                                            <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                        <Button Background="Transparent" Padding="4" Command="{Binding Search.ClearSearchCommand}" ToolTip.Tip="Clear Search">
                                            <Path Data="{StaticResource IconClear}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Search Inputs -->
                            <Border Grid.Row="1" Padding="12,8" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="6">
                                    <!-- Search Box with Modifiers -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding Search.SearchQuery, Mode=TwoWay}"
                                                 KeyDown="OnSearchKeyDown"
                                                 Watermark="Search files..." Padding="8,5" FontSize="12"
                                                 Background="#1E1E1E" Foreground="#CCCCCC"
                                                 BorderBrush="#3C3C3C" CornerRadius="2" />
                                        <!-- Modifier Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
                                            <Button Padding="4" CornerRadius="2" BorderThickness="1"
                                                    Background="{Binding Search.MatchCase, Converter={x:Static views:BoolToToggleBackgroundConverter.Instance}}"
                                                    BorderBrush="{Binding Search.MatchCase, Converter={x:Static views:BoolToToggleBorderBrushConverter.Instance}}"
                                                    Command="{Binding Search.ToggleMatchCaseCommand}" ToolTip.Tip="Match Case (Alt+C)">
                                                <Path Data="{StaticResource IconCaseSensitive}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                            </Button>
                                            <Button Padding="4" CornerRadius="2" BorderThickness="1"
                                                    Background="{Binding Search.MatchWholeWord, Converter={x:Static views:BoolToToggleBackgroundConverter.Instance}}"
                                                    BorderBrush="{Binding Search.MatchWholeWord, Converter={x:Static views:BoolToToggleBorderBrushConverter.Instance}}"
                                                    Command="{Binding Search.ToggleMatchWholeWordCommand}" ToolTip.Tip="Match Whole Word (Alt+W)">
                                                <Path Data="{StaticResource IconWholeWord}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                            </Button>
                                            <Button Padding="4" CornerRadius="2" BorderThickness="1"
                                                    Background="{Binding Search.UseRegex, Converter={x:Static views:BoolToToggleBackgroundConverter.Instance}}"
                                                    BorderBrush="{Binding Search.UseRegex, Converter={x:Static views:BoolToToggleBorderBrushConverter.Instance}}"
                                                    Command="{Binding Search.ToggleUseRegexCommand}" ToolTip.Tip="Use Regular Expression (Alt+R)">
                                                <Path Data="{StaticResource IconRegex}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Summary -->
                                    <TextBlock Text="{Binding Search.ResultSummary}" FontSize="11" Foreground="#888888" Margin="2,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Results Tree -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Search.SearchResults}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type services:SearchFileResult}">
                                            <StackPanel Margin="0,2">
                                                <!-- File Header -->
                                                <Button Background="#252526" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Padding="6,4" BorderThickness="0" CornerRadius="3"
                                                        Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).Search.ToggleFileExpandedCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                        <Path Grid.Column="0" Data="{Binding IsExpanded, Converter={x:Static views:BoolToChevronIconConverter.Instance}}" Width="8" Height="8" Fill="#CCCCCC" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <Image Grid.Column="1" Source="{Binding FilePath, Converter={x:Static views:MaterialIconImageConverter.Instance}}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding RelativePath}" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Grid.Column="3" Background="#04395E" CornerRadius="8" Padding="6,1" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding MatchCount}" FontSize="10" Foreground="#9CDCFE" />
                                                        </Border>
                                                    </Grid>
                                                </Button>

                                                <!-- Match Items -->
                                                <ItemsControl ItemsSource="{Binding Matches}" IsVisible="{Binding IsExpanded}" Margin="16,1,0,3">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type services:SearchMatchItem}">
                                                            <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                    Padding="4,2" BorderThickness="0"
                                                                    Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).Search.OpenMatchCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <TextBlock Grid.Column="0" Text="{Binding LineNumber, StringFormat='{}{0}: '}" FontSize="11" Foreground="#888888" Margin="0,0,4,0" />
                                                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding PrefixText}" Foreground="#AAAAAA" />
                                                                        <Run Text="{Binding MatchText}" Background="#515C6B" Foreground="#FFFFFF" FontWeight="Bold" />
                                                                        <Run Text="{Binding SuffixText}" Foreground="#AAAAAA" />
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============================================================= -->
                        <!-- 2: SOURCE CONTROL (REAL GIT INTEGRATION)                      -->
                        <!-- ============================================================= -->
                        <Grid RowDefinitions="35,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ActiveActivityIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=2}">
                            <!-- Header (35px) -->
                            <Border Grid.Row="0" Height="35" Padding="14,0,8,0" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconGit}" Width="13" Height="13" Fill="#F05032" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="SOURCE CONTROL" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SideBarHeaderForegroundBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Action Toolbar -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Background="Transparent" Padding="4" Command="{Binding SourceControl.RefreshStatusCommand}" ToolTip.Tip="Refresh Git Status">
                                            <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                        <Button Background="Transparent" Padding="4" Command="{Binding SourceControl.StageAllCommand}" ToolTip.Tip="Stage All Changes">
                                            <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                        <Button Background="Transparent" Padding="4" Command="{Binding SourceControl.CommitCommand}" ToolTip.Tip="Commit (Ctrl+Enter)">
                                            <Path Data="{StaticResource IconCheck}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                        <Button Background="Transparent" Padding="4" Command="{Binding SourceControl.PushCommand}" ToolTip.Tip="Push to Remote">
                                            <Path Data="{StaticResource IconSync}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Non-Repository State -->
                            <StackPanel Grid.Row="1" IsVisible="{Binding !SourceControl.IsGitRepository}" Margin="16" Spacing="12" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGit}" Width="36" Height="36" Fill="#F05032" Stretch="Uniform" HorizontalAlignment="Center" />
                                <TextBlock Text="No source control repository found." FontSize="12" Foreground="#888888" TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Background="#0078D4" Foreground="White" HorizontalAlignment="Center" Padding="14,6" CornerRadius="3"
                                        Command="{Binding SourceControl.InitRepositoryCommand}">
                                    <TextBlock Text="Initialize Repository" FontSize="12" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>

                            <!-- Git Repository Active View -->
                            <ScrollViewer Grid.Row="1" IsVisible="{Binding SourceControl.IsGitRepository}" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,6,0,12" Spacing="4">
                                    <!-- Branch Info Bar -->
                                    <Border Margin="10,0,10,6" Background="#252526" Padding="8,4" CornerRadius="3">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconGit}" Width="13" Height="13" Fill="#F05032" Stretch="Uniform" VerticalAlignment="Center" />
                                                <Path Data="{StaticResource IconBranch}" Width="12" Height="12" Fill="#75BEFF" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SourceControl.CurrentBranch}" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceControl.AheadCount, StringFormat='↑{0}'}" FontSize="10" Foreground="#89D185" IsVisible="{Binding SourceControl.AheadCount}" />
                                                <TextBlock Text="{Binding SourceControl.BehindCount, StringFormat='↓{0}'}" FontSize="10" Foreground="#F14C4C" IsVisible="{Binding SourceControl.BehindCount}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Commit Message Input Box -->
                                    <Border Margin="10,0,10,6">
                                        <StackPanel Spacing="6">
                                            <TextBox Text="{Binding SourceControl.CommitMessage, Mode=TwoWay}"
                                                     KeyDown="OnCommitKeyDown"
                                                     Watermark="Message (Ctrl+Enter to commit)"
                                                     AcceptsReturn="True" Height="65"
                                                     Padding="8,6" FontSize="12"
                                                     Background="#1E1E1E" Foreground="#CCCCCC"
                                                     BorderBrush="#3C3C3C" CornerRadius="3" />
                                            <Button Background="#0078D4" Foreground="White"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Padding="0,6" CornerRadius="3"
                                                    Command="{Binding SourceControl.CommitCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource IconCheck}" Width="11" Height="11" Fill="White" Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="Commit" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- STAGED CHANGES Section -->
                                    <StackPanel IsVisible="{Binding SourceControl.HasStagedChanges}">
                                        <!-- Staged Header -->
                                        <Button Background="{StaticResource SideBarSectionHeaderBackgroundBrush}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="8,3" BorderThickness="0"
                                                Command="{Binding SourceControl.ToggleStagedSectionCommand}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Path Grid.Column="0" Data="{Binding SourceControl.IsStagedExpanded, Converter={x:Static views:BoolToChevronIconConverter.Instance}}" Width="8" Height="8" Fill="#CCCCCC" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="STAGED CHANGES" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SourceControl.StagedCount}" FontSize="10" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Background="Transparent" Padding="2" BorderThickness="0" Command="{Binding SourceControl.UnstageAllCommand}" ToolTip.Tip="Unstage All">
                                                    <Path Data="{StaticResource IconMinus}" Width="10" Height="10" Fill="#858585" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Button>

                                        <!-- Staged Items List -->
                                        <ItemsControl ItemsSource="{Binding SourceControl.StagedChanges}" IsVisible="{Binding SourceControl.IsStagedExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:GitFileItem}">
                                                    <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            Padding="12,3" BorderThickness="0"
                                                            Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).SourceControl.OpenFileCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                            <Image Grid.Column="0" Source="{Binding FullPath, Converter={x:Static views:MaterialIconImageConverter.Instance}}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding StatusChar}" FontSize="11" FontWeight="Bold" Foreground="{Binding Status, Converter={x:Static views:GitStatusBrushConverter.Instance}}" Margin="6,0" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusTooltip}" />
                                                            <Button Grid.Column="3" Background="Transparent" Padding="3" BorderThickness="0"
                                                                    Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).SourceControl.UnstageFileCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="Unstage Changes">
                                                                <Path Data="{StaticResource IconMinus}" Width="8" Height="8" Fill="#858585" Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- CHANGES Section -->
                                    <StackPanel>
                                        <!-- Changes Header -->
                                        <Button Background="{StaticResource SideBarSectionHeaderBackgroundBrush}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="8,3" BorderThickness="0"
                                                Command="{Binding SourceControl.ToggleChangesSectionCommand}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Path Grid.Column="0" Data="{Binding SourceControl.IsChangesExpanded, Converter={x:Static views:BoolToChevronIconConverter.Instance}}" Width="8" Height="8" Fill="#CCCCCC" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="CHANGES" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SourceControl.ChangesCount}" FontSize="10" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Background="Transparent" Padding="2" BorderThickness="0" Command="{Binding SourceControl.StageAllCommand}" ToolTip.Tip="Stage All">
                                                    <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Fill="#858585" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Button>

                                        <!-- Changes Items List -->
                                        <ItemsControl ItemsSource="{Binding SourceControl.WorkingChanges}" IsVisible="{Binding SourceControl.IsChangesExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:GitFileItem}">
                                                    <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            Padding="12,3" BorderThickness="0"
                                                            Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).SourceControl.OpenFileCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                            <Image Grid.Column="0" Source="{Binding FullPath, Converter={x:Static views:MaterialIconImageConverter.Instance}}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding StatusChar}" FontSize="11" FontWeight="Bold" Foreground="{Binding Status, Converter={x:Static views:GitStatusBrushConverter.Instance}}" Margin="6,0" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusTooltip}" />
                                                            <Button Grid.Column="3" Background="Transparent" Padding="3" BorderThickness="0"
                                                                    Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).SourceControl.DiscardChangesCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="Discard Changes">
                                                                <Path Data="{StaticResource IconDiscard}" Width="9" Height="9" Fill="#858585" Stretch="Uniform" />
                                                            </Button>
                                                            <Button Grid.Column="4" Background="Transparent" Padding="3" BorderThickness="0"
                                                                    Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).SourceControl.StageFileCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="Stage Changes">
                                                                <Path Data="{StaticResource IconPlus}" Width="9" Height="9" Fill="#858585" Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============================================================= -->
                        <!-- 3: SETTINGS VIEW                                              -->
                        <!-- ============================================================= -->
                        <Grid RowDefinitions="35,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ActiveActivityIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=3}">
                            <!-- Header (35px) -->
                            <Border Grid.Row="0" Height="35" Padding="14,0,8,0" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="SETTINGS" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SideBarHeaderForegroundBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Background="Transparent" Padding="4" Command="{Binding Settings.ResetDefaultsCommand}" ToolTip.Tip="Reset to Defaults">
                                        <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Settings Content -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12" Spacing="16">
                                    <!-- Category: Editor -->
                                    <Border Background="#252526" Padding="12" CornerRadius="4">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Editor" FontWeight="Bold" FontSize="13" Foreground="#E0E0E0" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Font Size" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding Settings.EditorFontSize, Mode=TwoWay}" Minimum="10" Maximum="28" Width="100" Height="28" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Tab Size" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.AvailableTabSizes}" SelectedItem="{Binding Settings.EditorTabSize, Mode=TwoWay}" Width="100" Height="28" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Word Wrap" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.WordWrap, Mode=TwoWay}" OnContent="" OffContent="" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Category: Terminal -->
                                    <Border Background="#252526" Padding="12" CornerRadius="4">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Terminal" FontWeight="Bold" FontSize="13" Foreground="#E0E0E0" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Engine" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="Windows ConPTY (Native)" FontSize="11" Foreground="#9CDCFE" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Font Size" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding Settings.TerminalFontSize, Mode=TwoWay}" Minimum="10" Maximum="24" Width="100" Height="28" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Cursor Blinking" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.CursorBlinking, Mode=TwoWay}" OnContent="" OffContent="" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Category: Appearance -->
                                    <Border Background="#252526" Padding="12" CornerRadius="4">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Appearance" FontWeight="Bold" FontSize="13" Foreground="#E0E0E0" />
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Color Theme" FontSize="12" Foreground="#CCCCCC" />
                                                <ComboBox ItemsSource="{Binding Settings.AvailableThemes}" SelectedItem="{Binding Settings.SelectedTheme, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="28" />
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Icon Theme" FontSize="12" Foreground="#CCCCCC" />
                                                <TextBlock Text="Philipp Kief Material Icon Theme (Official 1,250+ Icons)" FontSize="11" Foreground="#9CDCFE" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ============================================================= -->
                        <!-- 4: EXTENSIONS VIEW (OPEN VSX MARKETPLACE)                     -->
                        <!-- ============================================================= -->
                        <Grid RowDefinitions="35,Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ActiveActivityIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=4}">
                            <!-- Header (35px) -->
                            <Border Grid.Row="0" Height="35" Padding="14,0,8,0" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="EXTENSIONS" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SideBarHeaderForegroundBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <Button Background="Transparent" Padding="4" Command="{Binding Extensions.RefreshInstalledCommand}" ToolTip.Tip="Refresh Installed">
                                            <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Extensions Search & Filter Subheader -->
                            <Border Grid.Row="1" Padding="10,8" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="8">
                                    <!-- Search Input -->
                                    <TextBox Text="{Binding Extensions.SearchQuery, Mode=TwoWay}"
                                             Watermark="Search Extensions in Marketplace..." Padding="8,5" FontSize="12"
                                             Background="#1E1E1E" Foreground="#CCCCCC"
                                             BorderBrush="#3C3C3C" CornerRadius="2" />

                                    <!-- Filter Tabs: Marketplace / Installed -->
                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0" 
                                                Background="{Binding Extensions.IsMarketplaceTab, Converter={x:Static views:TabBackgroundConverter.Instance}}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Padding="0,5" BorderThickness="0" CornerRadius="3,0,0,3"
                                                Command="{Binding Extensions.SelectTabCommand}" CommandParameter="0">
                                            <TextBlock Text="Marketplace" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" />
                                        </Button>
                                        <Button Grid.Column="1" 
                                                Background="{Binding Extensions.IsInstalledTab, Converter={x:Static views:TabBackgroundConverter.Instance}}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Padding="0,5" BorderThickness="0" CornerRadius="0,3,3,0"
                                                Command="{Binding Extensions.SelectTabCommand}" CommandParameter="1">
                                            <TextBlock Text="{Binding Extensions.InstalledCount, StringFormat='Installed ({0})'}" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" />
                                        </Button>
                                    </Grid>

                                    <!-- Status Message -->
                                    <TextBlock Text="{Binding Extensions.StatusMessage}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Extensions List Views -->
                            <Grid Grid.Row="2">
                                <!-- Marketplace List -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Extensions.IsMarketplaceTab}">
                                    <ItemsControl ItemsSource="{Binding Extensions.MarketplaceExtensions}" Margin="0,4,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ExtensionItemViewModel}">
                                                <Button Background="#1E1E1E" Margin="6,3" Padding="8" CornerRadius="4" BorderBrush="#2B2B2B" BorderThickness="1"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding OpenDetailsCommand}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <!-- Icon -->
                                                        <Border Grid.Column="0" Width="36" Height="36" Background="#282828" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Top">
                                                            <Path Data="{StaticResource IconExtensions}" Width="18" Height="18" Fill="#0078D4" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Text Info -->
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="#0078D4" />
                                                                <TextBlock Text="{Binding FormattedDownloads, StringFormat='⬇ {0}'}" FontSize="10" Foreground="#888888" />
                                                                <TextBlock Text="{Binding FormattedRating}" FontSize="10" Foreground="#CCA700" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Status & Action Controls -->
                                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                                                            <!-- Uninstalled State -> Install Button -->
                                                            <Button Background="#0078D4" Foreground="White" Padding="10,4" CornerRadius="2"
                                                                    IsVisible="{Binding !IsInstalled}"
                                                                    IsEnabled="{Binding !IsInstalling}"
                                                                    Command="{Binding InstallCommand}" ToolTip.Tip="Install from Open VSX">
                                                                <TextBlock Text="Install" FontSize="11" FontWeight="SemiBold" />
                                                            </Button>

                                                            <!-- Installing State -->
                                                            <Border Background="#252526" Padding="6,3" CornerRadius="2" IsVisible="{Binding IsInstalling}">
                                                                <TextBlock Text="Installing..." FontSize="10" Foreground="#75BEFF" />
                                                            </Border>

                                                            <!-- Installed State Badge & Actions -->
                                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsInstalled}">
                                                                <Border Background="#1C3322" BorderBrush="#2EA043" BorderThickness="1" Padding="6,2" CornerRadius="2">
                                                                    <TextBlock Text="Installed" FontSize="10" FontWeight="SemiBold" Foreground="#3FB950" />
                                                                </Border>
                                                                <Button Background="Transparent" Padding="4" Command="{Binding UninstallCommand}" ToolTip.Tip="Uninstall Extension">
                                                                    <Path Data="{StaticResource IconTrash}" Width="10" Height="10" Fill="#F85149" Stretch="Uniform" />
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Installed List -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Extensions.IsInstalledTab}">
                                    <ItemsControl ItemsSource="{Binding Extensions.InstalledExtensions}" Margin="0,4,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ExtensionItemViewModel}">
                                                <Button Background="#1E1E1E" Margin="6,3" Padding="8" CornerRadius="4" BorderBrush="#2B2B2B" BorderThickness="1"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding OpenDetailsCommand}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <!-- Icon -->
                                                        <Border Grid.Column="0" Width="36" Height="36" Background="#282828" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Top">
                                                            <Path Data="{StaticResource IconExtensions}" Width="18" Height="18" Fill="#3FB950" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Text Info -->
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="#0078D4" />
                                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10" Foreground="#888888" />
                                                                <TextBlock Text="Enabled" FontSize="10" Foreground="#3FB950" IsVisible="{Binding IsEnabled}" />
                                                                <TextBlock Text="Disabled" FontSize="10" Foreground="#888888" IsVisible="{Binding !IsEnabled}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Installed Actions -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                                                            <Button Background="#252526" Foreground="#CCCCCC" Padding="6,3" CornerRadius="2"
                                                                    Command="{Binding ToggleEnabledCommand}" ToolTip.Tip="Enable/Disable Extension">
                                                                <TextBlock Text="{Binding IsEnabled, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=0, FallbackValue='Toggle'}" FontSize="10" />
                                                            </Button>
                                                            <Button Background="Transparent" Padding="4" Command="{Binding UninstallCommand}" ToolTip.Tip="Uninstall Extension">
                                                                <Path Data="{StaticResource IconTrash}" Width="11" Height="11" Fill="#F85149" Stretch="Uniform" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- ========================================================================= -->
                        <!-- 5. RUN AND DEBUG VIEW (ActiveActivityIndex = 5)                           -->
                        <!-- ========================================================================= -->
                        <Grid RowDefinitions="Auto,*" 
                              IsVisible="{Binding ActiveActivityIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=5}">
                            
                            <!-- Run & Debug Top Launch Bar -->
                            <Border Grid.Row="0" Background="{StaticResource SideBarHeaderBackgroundBrush}" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <ComboBox Grid.Column="0" 
                                              ItemsSource="{Binding Debug.Configurations}" 
                                              SelectedItem="{Binding Debug.SelectedConfiguration}"
                                              Background="#252526" Foreground="#CCCCCC"
                                              BorderBrush="#3C3C3C" BorderThickness="1"
                                              CornerRadius="2" FontSize="11" Height="26"
                                              HorizontalAlignment="Stretch" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    
                                    <!-- Green Play Button -->
                                    <Button Grid.Column="1" Background="#388A34" Margin="6,0,0,0" Padding="8,4" CornerRadius="2"
                                            Command="{Binding Debug.StartDebuggingCommand}" ToolTip.Tip="Start Debugging (F5)">
                                        <Path Data="{StaticResource IconPlay}" Width="12" Height="12" Fill="White" Stretch="Uniform" />
                                    </Button>

                                    <!-- Stop Button if Debugging -->
                                    <Button Grid.Column="2" Background="#C72E2E" Margin="4,0,0,0" Padding="8,4" CornerRadius="2"
                                            IsVisible="{Binding Debug.IsDebugging}"
                                            Command="{Binding Debug.StopCommand}" ToolTip.Tip="Stop (Shift+F5)">
                                        <Path Data="{StaticResource IconStop}" Width="11" Height="11" Fill="White" Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Debug Sections: Variables, Watch, Call Stack, Breakpoints -->
                            <ScrollViewer Grid.Row="1">
                                <StackPanel Spacing="1">
                                    <!-- Status Banner -->
                                    <Border Background="#252526" Padding="10,6" BorderBrush="#333333" BorderThickness="0,0,0,1" IsVisible="{Binding Debug.IsDebugging}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Debug.IsPaused, Converter={x:Static views:TabBackgroundConverter.Instance}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Debug.StatusText}" FontSize="11" Foreground="#FFE66D" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- 1. VARIABLES ACCORDION -->
                                    <Border Background="#252526" Padding="10,6">
                                        <TextBlock Text="VARIABLES" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Debug.Variables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="10,2">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0" Margin="0,2" />
                                                    <ItemsControl ItemsSource="{Binding Children}" Margin="10,0,0,4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name, StringFormat='{}{0}: '}" FontSize="11" Foreground="#9CDCFE" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" Foreground="#CE9178" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="10" Foreground="#808080" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 2. WATCH ACCORDION -->
                                    <Border Background="#252526" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="WATCH" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Background="Transparent" Padding="4,0" Command="{Binding Debug.OpenAddWatchCommand}" ToolTip.Tip="Add Expression">
                                                <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Fill="#CCCCCC" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Add Watch Inline Box -->
                                    <Border IsVisible="{Binding Debug.IsAddingWatch}" Background="#1E1E1E" Padding="8,4" BorderBrush="#0078D4" BorderThickness="1" Margin="8,4">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Debug.NewWatchExpression, Mode=TwoWay}" FontSize="11" Watermark="Expression to watch..." BorderThickness="0" Background="Transparent" Foreground="White" />
                                            <Button Grid.Column="1" Background="Transparent" Padding="4" Command="{Binding Debug.SaveWatchExpressionCommand}">
                                                <Path Data="{StaticResource IconCheck}" Width="10" Height="10" Fill="#4EC9B0" Stretch="Uniform" />
                                            </Button>
                                            <Button Grid.Column="2" Background="Transparent" Padding="4" Command="{Binding Debug.CancelAddWatchCommand}">
                                                <Path Data="{StaticResource IconClose}" Width="10" Height="10" Fill="#808080" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Debug.WatchItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Expression, StringFormat='{}{0}: '}" FontSize="11" Foreground="#DCDCAA" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" Foreground="#B5CEA8" Margin="4,0" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Background="Transparent" Padding="2" Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).Debug.RemoveWatchCommand}" CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconClose}" Width="9" Height="9" Fill="#808080" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 3. CALL STACK ACCORDION -->
                                    <Border Background="#252526" Padding="10,6">
                                        <TextBlock Text="CALL STACK" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" />
                                    </Border>
                                    <ListBox ItemsSource="{Binding Debug.StackFrames}"
                                             SelectedItem="{Binding Debug.SelectedStackFrame}"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" Margin="4,1">
                                                    <Path Grid.Column="0" Data="{StaticResource IconChevronRight}" Width="8" Height="8" Fill="#FFE66D" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11" Foreground="#D4D4D4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 4. BREAKPOINTS ACCORDION -->
                                    <Border Background="#252526" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="BREAKPOINTS" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Background="Transparent" Padding="4,0" Command="{Binding Debug.ClearAllBreakpointsCommand}" ToolTip.Tip="Remove All Breakpoints">
                                                <Path Data="{StaticResource IconTrash}" Width="10" Height="10" Fill="#808080" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Debug.Breakpoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,2">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayLocation}" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Background="Transparent" Padding="2" 
                                                            Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).Debug.RemoveBreakpointCommand}" 
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconClose}" Width="9" Height="9" Fill="#808080" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ========================================================================= -->
                        <!-- 6. REMOTE EXPLORER VIEW (ActiveActivityIndex = 6)                          -->
                        <!-- ========================================================================= -->
                        <Grid RowDefinitions="Auto,*" 
                              IsVisible="{Binding ActiveActivityIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=6}">
                            
                            <!-- Remote Explorer Top Actions -->
                            <Border Grid.Row="0" Background="{StaticResource SideBarHeaderBackgroundBrush}" BorderBrush="{StaticResource SideBarBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="REMOTE EXPLORER" FontSize="11" FontWeight="Bold" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Background="Transparent" Padding="4" Command="{Binding RemoteExplorer.RefreshTargetsCommand}" ToolTip.Tip="Refresh Targets">
                                        <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                    </Button>
                                    <Button Grid.Column="2" Background="Transparent" Margin="4,0,0,0" Padding="4" Command="{Binding RemoteExplorer.OpenSshConfigFileCommand}" ToolTip.Tip="Open ~/.ssh/config">
                                        <Path Data="{StaticResource IconFile}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                    </Button>
                                    <Button Grid.Column="3" Background="Transparent" Margin="4,0,0,0" Padding="4" Command="{Binding RemoteExplorer.OpenAddTargetDialogCommand}" ToolTip.Tip="Add SSH Target">
                                        <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1">
                                <StackPanel Spacing="2">
                                    <!-- Active Session Banner -->
                                    <Border Background="#1F3D59" Padding="10,8" Margin="8,6" CornerRadius="4" IsVisible="{Binding RemoteExplorer.IsConnected}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Path Grid.Column="0" Data="{StaticResource IconRemote}" Width="14" Height="14" Fill="#4EC9B0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RemoteExplorer.ActiveTargetTitle}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                <TextBlock Text="{Binding RemoteExplorer.StatusMessage}" FontSize="10" Foreground="#85E89D" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Background="#902020" Foreground="White" Padding="6,3" CornerRadius="2"
                                                    Command="{Binding RemoteExplorer.DisconnectCommand}">
                                                <TextBlock Text="Disconnect" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Add New SSH Host Card Form -->
                                    <Border IsVisible="{Binding RemoteExplorer.IsAddTargetDialogOpen}" Background="#252526" Padding="10" Margin="8,4" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="4">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Add SSH Host" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            <TextBox Text="{Binding RemoteExplorer.NewHostInput, Mode=TwoWay}" Watermark="Host / IP (e.g. 192.168.1.100)" FontSize="11" />
                                            <TextBox Text="{Binding RemoteExplorer.NewUserHostInput, Mode=TwoWay}" Watermark="Username (e.g. ubuntu)" FontSize="11" />
                                            <TextBox Text="{Binding RemoteExplorer.NewPortInput, Mode=TwoWay}" Watermark="Port (e.g. 22)" FontSize="11" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,4,0,0">
                                                <Button Content="Save &amp; Connect" Background="#0078D4" Foreground="White" FontSize="10" Padding="8,4" CornerRadius="2" Command="{Binding RemoteExplorer.SaveNewTargetCommand}" />
                                                <Button Content="Cancel" Background="#333333" Foreground="#CCCCCC" FontSize="10" Padding="8,4" CornerRadius="2" Command="{Binding RemoteExplorer.CloseAddTargetDialogCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Add Port Forward Form -->
                                    <Border IsVisible="{Binding RemoteExplorer.IsAddPortDialogOpen}" Background="#252526" Padding="10" Margin="8,4" BorderBrush="#4EC9B0" BorderThickness="1" CornerRadius="4">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Forward a Port" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            <TextBox Text="{Binding RemoteExplorer.NewForwardLocalPort, Mode=TwoWay}" Watermark="Local Port (e.g. 3000)" FontSize="11" />
                                            <TextBox Text="{Binding RemoteExplorer.NewForwardRemotePort, Mode=TwoWay}" Watermark="Remote Port (e.g. 3000)" FontSize="11" />
                                            <TextBox Text="{Binding RemoteExplorer.NewForwardLabel, Mode=TwoWay}" Watermark="Label (e.g. Web App)" FontSize="11" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,4,0,0">
                                                <Button Content="Forward Port" Background="#107C41" Foreground="White" FontSize="10" Padding="8,4" CornerRadius="2" Command="{Binding RemoteExplorer.SavePortForwardCommand}" />
                                                <Button Content="Cancel" Background="#333333" Foreground="#CCCCCC" FontSize="10" Padding="8,4" CornerRadius="2" Command="{Binding RemoteExplorer.ClosePortForwardDialogCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 1. WSL TARGETS -->
                                    <Border Background="#252526" Padding="10,6">
                                        <TextBlock Text="WSL DISTRIBUTIONS" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RemoteExplorer.WslTargets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" Padding="8,6" Margin="6,2" CornerRadius="3" BorderBrush="#333333" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Path Grid.Column="0" Data="{StaticResource IconWsl}" Width="16" Height="16" Fill="#4FC1FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="#808080" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                            <Button Background="#0E639C" Foreground="White" Padding="6,3" CornerRadius="2"
                                                                    Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoteExplorer.ConnectCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="Connect to WSL">
                                                                <TextBlock Text="Connect" FontSize="10" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 2. SSH TARGETS -->
                                    <Border Background="#252526" Padding="10,6">
                                        <TextBlock Text="SSH HOSTS" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RemoteExplorer.SshTargets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" Padding="8,6" Margin="6,2" CornerRadius="3" BorderBrush="#333333" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Path Grid.Column="0" Data="{StaticResource IconSsh}" Width="16" Height="16" Fill="#DCDCAA" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="#808080" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                            <Button Background="#0E639C" Foreground="White" Padding="6,3" CornerRadius="2"
                                                                    Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoteExplorer.ConnectCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="Connect via SSH">
                                                                <TextBlock Text="Connect" FontSize="10" />
                                                            </Button>
                                                            <Button Background="Transparent" Padding="4"
                                                                    Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoteExplorer.RemoveTargetCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove SSH Host">
                                                                <Path Data="{StaticResource IconTrash}" Width="11" Height="11" Fill="#808080" Stretch="Uniform" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 3. CONTAINERS & TUNNELS -->
                                    <Border Background="#252526" Padding="10,6">
                                        <TextBlock Text="CONTAINERS &amp; TUNNELS" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RemoteExplorer.ContainerTargets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" Padding="8,6" Margin="6,2" CornerRadius="3" BorderBrush="#333333" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Path Grid.Column="0" Data="{StaticResource IconServer}" Width="16" Height="16" Fill="#4EC9B0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="#808080" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Background="#0E639C" Foreground="White" Padding="6,3" CornerRadius="2"
                                                                Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoteExplorer.ConnectCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="Attach" FontSize="10" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 4. PORT FORWARDING -->
                                    <Border Background="#252526" Padding="10,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="PORT FORWARDING" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Background="Transparent" Padding="4,0" Command="{Binding RemoteExplorer.OpenPortForwardDialogCommand}" ToolTip.Tip="Forward a Port">
                                                <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Fill="#CCCCCC" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RemoteExplorer.ForwardedPorts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" Padding="8,5" Margin="6,2" CornerRadius="3" BorderBrush="#333333" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#85E89D" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="11" FontWeight="SemiBold" Foreground="#4EC9B0" />
                                                            <TextBlock Text="{Binding LocalAddress}" FontSize="10" Foreground="#808080" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Background="Transparent" Padding="4"
                                                                Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoteExplorer.OpenPortInBrowserCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Open in Web Browser">
                                                            <Path Data="{StaticResource IconLink}" Width="11" Height="11" Fill="#9CDCFE" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Grid.Column="3" Background="Transparent" Padding="4"
                                                                Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoteExplorer.StopPortForwardCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Stop Forwarding">
                                                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Fill="#808080" Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 5. REMOTE FILES (When connected) -->
                                    <Border Background="#252526" Padding="10,6" IsVisible="{Binding RemoteExplorer.IsConnected}">
                                        <TextBlock Text="REMOTE WORKSPACE FILES" FontSize="11" FontWeight="Bold" Foreground="#BBBBBB" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RemoteExplorer.RemoteFiles}" IsVisible="{Binding RemoteExplorer.IsConnected}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoteExplorer.OpenRemoteFileCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Path Grid.Column="0" Data="{Binding IsDirectory, Converter={x:Static views:IconConverter.Instance}}" Width="12" Height="12" Fill="#DCDCAA" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Panel>
                </Border>

                <!-- 2.3 Resizer Splitter Handle between SideBar and Editor Area -->
                <GridSplitter Grid.Column="2" 
                              Width="4" 
                              Background="{StaticResource SideBarBorderBrush}" 
                              ResizeDirection="Columns" 
                              ResizeBehavior="PreviousAndNext"
                              IsVisible="{Binding IsSidebarOpen}" 
                              Cursor="SizeWestEast" />

                <!-- 2.4 Editor + Bottom Dock Region -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{Binding BottomPanel.IsOpen, Converter={x:Static views:PanelRowHeightConverter.Instance}}" MinHeight="0" MaxHeight="1200" />
                    </Grid.RowDefinitions>

                    <!-- Editor Region (Tabs + Editor Canvas / Extension Readme / Webview) -->
                    <Grid Grid.Row="0" RowDefinitions="35,*" ClipToBounds="True">
                        
                        <!-- Tabs Bar (35px) -->
                        <Border Grid.Row="0" Background="{StaticResource TabContainerBackgroundBrush}" BorderThickness="0" ClipToBounds="True">
                            <Grid>
                                <ListBox ItemsSource="{Binding Tabs}"
                                         SelectedItem="{Binding SelectedTab}"
                                         Classes="tab-strip"
                                         Background="Transparent"
                                         Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
                                            <Border Height="35"
                                                    Background="{Binding $parent[ListBoxItem].IsSelected, Converter={x:Static views:TabBackgroundConverter.Instance}}"
                                                    BorderThickness="0"
                                                    Padding="10,0"
                                                    PointerPressed="OnTabPointerPressed">
                                                <Grid>
                                                    <!-- Active Top Accent Line (1px) -->
                                                    <Border VerticalAlignment="Top" Height="1" 
                                                            Background="{StaticResource TabActiveBorderTopBrush}" 
                                                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                                                    
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconExtensions}" Width="13" Height="13" Fill="#0078D4" Stretch="Uniform" VerticalAlignment="Center" IsVisible="{Binding IsExtensionDetails}" />
                                                        <Path Data="{StaticResource IconLink}" Width="13" Height="13" Fill="#38BDF8" Stretch="Uniform" VerticalAlignment="Center" IsVisible="{Binding IsWebPreview}" />
                                                        <Path Data="{StaticResource IconExplorer}" Width="13" Height="13" Fill="#38BDF8" Stretch="Uniform" VerticalAlignment="Center" IsVisible="{Binding IsMarkdownPreview}" />
                                                        <Image Source="{Binding FilePath, Converter={x:Static views:MaterialIconImageConverter.Instance}}" 
                                                               Width="16" Height="16" 
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsTextDocument}" />
                                                        <TextBlock Text="{Binding Title}" FontSize="13" 
                                                                   Foreground="{Binding $parent[ListBoxItem].IsSelected, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=0}" 
                                                                   VerticalAlignment="Center" />
                                                        
                                                        <!-- Dirty Dot -->
                                                        <Ellipse Width="7" Height="7" Fill="#EBCB8B" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                                                        
                                                        <!-- Close Tab Button -->
                                                        <Button Background="Transparent" 
                                                                BorderThickness="0" 
                                                                CornerRadius="3"
                                                                Padding="3"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Close (Ctrl+W)">
                                                            <Path Data="{StaticResource IconClose}" Width="8" Height="8" Fill="#858585" Stretch="Uniform" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Right-aligned Tab Actions (Markdown Preview / Live Server Launch) -->
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="3"
                                            IsVisible="{Binding SelectedTab.IsMarkdownFile, FallbackValue=False}"
                                            Command="{Binding OpenMarkdownPreviewCommand}"
                                            ToolTip.Tip="Open Markdown Preview to the Side (Ctrl+Shift+V)">
                                        <Path Data="{StaticResource IconExplorer}" Width="14" Height="14" Fill="#38BDF8" Stretch="Uniform" />
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="3"
                                            IsVisible="{Binding SelectedTab.IsHtmlFile, FallbackValue=False}"
                                            Command="{Binding ToggleLiveServerCommand}"
                                            ToolTip.Tip="Launch Live Server Preview">
                                        <Path Data="{StaticResource IconLink}" Width="14" Height="14" Fill="#38BDF8" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Editor Content Surface (Switches between Code Editor, Markdown Preview, Web Preview, Extension Details, or Webview) -->
                        <Grid Grid.Row="1">
                            <!-- 1. Text Document Editor Surface -->
                            <views:EditorCanvas DocId="{Binding SelectedTab.DocId, FallbackValue=0}"
                                                Workspace="{Binding Workspace}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                IsVisible="{Binding SelectedTab.IsTextDocument, FallbackValue=False}" />

                            <!-- 2. Markdown Preview View -->
                            <views:MarkdownPreviewView MarkdownContent="{Binding SelectedTab.MarkdownText}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       IsVisible="{Binding SelectedTab.IsMarkdownPreview, FallbackValue=False}" />

                            <!-- 3. Web Preview View (Live Server / Local Server Tab) -->
                            <views:WebPreviewView Url="{Binding SelectedTab.WebPreviewUrl}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  IsVisible="{Binding SelectedTab.IsWebPreview, FallbackValue=False}" />

                            <!-- 4. Extension Details & README Tab View -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding SelectedTab.IsExtensionDetails, FallbackValue=False}" Background="#1E1E1E">
                                <StackPanel Margin="32,24,32,48" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
                                    <!-- Extension Header Banner -->
                                    <Border Background="#252526" Padding="20" CornerRadius="6" BorderBrush="#3C3C3C" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="64" Height="64" Background="#1E1E1E" CornerRadius="6" Margin="0,0,18,0" VerticalAlignment="Top">
                                                <Path Data="{StaticResource IconExtensions}" Width="32" Height="32" Fill="#0078D4" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- Metadata -->
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedTab.ExtensionItem.Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <TextBlock Text="{Binding SelectedTab.ExtensionItem.Description}" FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding SelectedTab.ExtensionItem.Publisher, StringFormat='Publisher: {0}'}" FontSize="11" Foreground="#75BEFF" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedTab.ExtensionItem.Version, StringFormat='Version: {0}'}" FontSize="11" Foreground="#888888" />
                                                    <TextBlock Text="{Binding SelectedTab.ExtensionItem.FormattedDownloads, StringFormat='⬇ {0}'}" FontSize="11" Foreground="#888888" />
                                                    <TextBlock Text="{Binding SelectedTab.ExtensionItem.FormattedRating}" FontSize="11" Foreground="#CCA700" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Header Live Action Buttons -->
                                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Background="#0078D4" Foreground="White" Padding="18,8" CornerRadius="4"
                                                        IsVisible="{Binding !SelectedTab.ExtensionItem.IsInstalled}"
                                                        IsEnabled="{Binding !SelectedTab.ExtensionItem.IsInstalling}"
                                                        Command="{Binding SelectedTab.ExtensionItem.InstallCommand}">
                                                    <TextBlock Text="Install" FontSize="13" FontWeight="Bold" />
                                                </Button>

                                                <Border Background="#2D2D30" Padding="12,6" CornerRadius="4" IsVisible="{Binding SelectedTab.ExtensionItem.IsInstalling}">
                                                    <TextBlock Text="Installing..." FontSize="12" Foreground="#75BEFF" FontWeight="SemiBold" />
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SelectedTab.ExtensionItem.IsInstalled}">
                                                    <Button Background="#383838" Foreground="#E0E0E0" Padding="14,6" CornerRadius="3"
                                                            Command="{Binding SelectedTab.ExtensionItem.ToggleEnabledCommand}">
                                                        <TextBlock Text="Disable" FontSize="12" IsVisible="{Binding SelectedTab.ExtensionItem.IsEnabled}" />
                                                    </Button>
                                                    <Button Background="#383838" Foreground="#E0E0E0" Padding="14,6" CornerRadius="3"
                                                            Command="{Binding SelectedTab.ExtensionItem.ToggleEnabledCommand}"
                                                            IsVisible="{Binding !SelectedTab.ExtensionItem.IsEnabled}">
                                                        <TextBlock Text="Enable" FontSize="12" Foreground="#3FB950" />
                                                    </Button>
                                                    <Button Background="#4A1E1E" Foreground="#F85149" Padding="14,6" CornerRadius="3"
                                                            Command="{Binding SelectedTab.ExtensionItem.UninstallCommand}">
                                                        <TextBlock Text="Uninstall" FontSize="12" FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Readme Documentation Section -->
                                    <Border Background="#252526" Padding="24" CornerRadius="6" BorderBrush="#3C3C3C" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="DOCUMENTATION (README)" FontSize="12" FontWeight="Bold" Foreground="#888888" />
                                            <Border Height="1" Background="#3C3C3C" Margin="0,0,0,8" />
                                            <views:MarkdownPreviewView MarkdownContent="{Binding SelectedTab.ReadmeText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 5. Extension Webview Container Surface -->
                            <views:ExtensionWebviewControl PanelId="{Binding SelectedTab.WebviewPanelId, FallbackValue=''}"
                                                           HtmlContent="{Binding SelectedTab.WebviewHtml, FallbackValue=''}"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           IsVisible="{Binding SelectedTab.IsExtensionWebview, FallbackValue=False}" />

                            <!-- 4. Floating VS Code Debug Controls Bar -->
                            <Border HorizontalAlignment="Center" 
                                    VerticalAlignment="Top" 
                                    Margin="0,10,0,0"
                                    Background="#252526"
                                    BorderBrush="#454545"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,3"
                                    IsVisible="{Binding Debug.IsDebugging}"
                                    BoxShadow="0 4 12 0 #40000000">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <!-- Continue / Pause -->
                                    <Button Background="Transparent" Padding="6,4" CornerRadius="3"
                                            IsVisible="{Binding Debug.IsPaused}"
                                            Command="{Binding Debug.ContinueCommand}" ToolTip.Tip="Continue (F5)">
                                        <Path Data="{StaticResource IconPlay}" Width="13" Height="13" Fill="#75BEFF" Stretch="Uniform" />
                                    </Button>
                                    <Button Background="Transparent" Padding="6,4" CornerRadius="3"
                                            IsVisible="{Binding !Debug.IsPaused}"
                                            Command="{Binding Debug.PauseCommand}" ToolTip.Tip="Pause (F6)">
                                        <Path Data="{StaticResource IconPause}" Width="13" Height="13" Fill="#75BEFF" Stretch="Uniform" />
                                    </Button>

                                    <!-- Step Over -->
                                    <Button Background="Transparent" Padding="6,4" CornerRadius="3"
                                            Command="{Binding Debug.StepOverCommand}" ToolTip.Tip="Step Over (F10)">
                                        <Path Data="{StaticResource IconStepOver}" Width="13" Height="13" Fill="#75BEFF" Stretch="Uniform" />
                                    </Button>

                                    <!-- Step Into -->
                                    <Button Background="Transparent" Padding="6,4" CornerRadius="3"
                                            Command="{Binding Debug.StepIntoCommand}" ToolTip.Tip="Step Into (F11)">
                                        <Path Data="{StaticResource IconStepInto}" Width="13" Height="13" Fill="#75BEFF" Stretch="Uniform" />
                                    </Button>

                                    <!-- Step Out -->
                                    <Button Background="Transparent" Padding="6,4" CornerRadius="3"
                                            Command="{Binding Debug.StepOutCommand}" ToolTip.Tip="Step Out (Shift+F11)">
                                        <Path Data="{StaticResource IconStepOut}" Width="13" Height="13" Fill="#75BEFF" Stretch="Uniform" />
                                    </Button>

                                    <!-- Restart -->
                                    <Button Background="Transparent" Padding="6,4" CornerRadius="3"
                                            Command="{Binding Debug.RestartCommand}" ToolTip.Tip="Restart (Ctrl+Shift+F5)">
                                        <Path Data="{StaticResource IconRestart}" Width="13" Height="13" Fill="#3FB950" Stretch="Uniform" />
                                    </Button>

                                    <!-- Stop -->
                                    <Button Background="Transparent" Padding="6,4" CornerRadius="3"
                                            Command="{Binding Debug.StopCommand}" ToolTip.Tip="Stop (Shift+F5)">
                                        <Path Data="{StaticResource IconStop}" Width="13" Height="13" Fill="#F85149" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Resizer Splitter Handle between Editor and Bottom Panel -->
                    <GridSplitter Grid.Row="1" Height="4" Background="{StaticResource PanelBorderBrush}" ResizeDirection="Rows" IsVisible="{Binding BottomPanel.IsOpen}" Cursor="SizeNorthSouth" />

                    <!-- Bottom Dockable Panel Border with Direct Drag Handle Resizing -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource PanelBackgroundBrush}" 
                            BorderBrush="{StaticResource PanelBorderBrush}" 
                            BorderThickness="0,1,0,0"
                            IsVisible="{Binding BottomPanel.IsOpen}">
                        <Grid RowDefinitions="35,*">
                            <!-- Panel Header (35px) -->
                            <Border Grid.Row="0" Height="35" Background="{StaticResource TitleBarBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <!-- Terminal Tab -->
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnTerminalTabClick" PointerPressed="OnBottomPanelTabPointerPressed">
                                            <Grid Height="35">
                                                <Border VerticalAlignment="Bottom" Height="2" Background="{StaticResource PanelActiveBorderBrush}" 
                                                        IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=0}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconTerminal}" Width="13" Height="13" 
                                                          Fill="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=0}" 
                                                          Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="TERMINAL" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=0}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Output Tab -->
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnOutputTabClick" PointerPressed="OnBottomPanelTabPointerPressed">
                                            <Grid Height="35">
                                                <Border VerticalAlignment="Bottom" Height="2" Background="{StaticResource PanelActiveBorderBrush}" 
                                                        IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=1}" />
                                                <TextBlock Text="OUTPUT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=1}" />
                                            </Grid>
                                        </Button>

                                        <!-- Problems Tab -->
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnProblemsTabClick" PointerPressed="OnBottomPanelTabPointerPressed">
                                            <Grid Height="35">
                                                <Border VerticalAlignment="Bottom" Height="2" Background="{StaticResource PanelActiveBorderBrush}" 
                                                        IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=2}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconError}" Width="13" Height="13" 
                                                          Fill="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=2}" 
                                                          Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="PROBLEMS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=2}" />
                                                    <TextBlock Text="{Binding BottomPanel.ErrorCount, StringFormat='({0})'}" 
                                                               FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Debug Console Tab -->
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnDebugConsoleTabClick" PointerPressed="OnBottomPanelTabPointerPressed">
                                            <Grid Height="35">
                                                <Border VerticalAlignment="Bottom" Height="2" Background="{StaticResource PanelActiveBorderBrush}" 
                                                        IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=3}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconPlay}" Width="12" Height="12" 
                                                          Fill="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=3}" 
                                                          Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="DEBUG CONSOLE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=3}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>

                                    <!-- Panel Actions Toolbar -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <!-- Profile Selector '+' Button (when Terminal tab active) -->
                                        <Button x:Name="NewTerminalProfileButton"
                                                Background="Transparent" Padding="5" 
                                                ToolTip.Tip="New Terminal with Profile (PowerShell, CMD, Git Bash, WSL...)"
                                                IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=0}">
                                            <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Fill="#CCCCCC" Stretch="Uniform" />
                                            <Button.Flyout>
                                                <MenuFlyout ItemsSource="{Binding BottomPanel.AvailableProfiles}">
                                                    <MenuFlyout.ItemContainerTheme>
                                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="models:TerminalProfile">
                                                            <Setter Property="Header" Value="{Binding Name}" />
                                                            <Setter Property="Command" Value="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).BottomPanel.LaunchProfileCommand}" />
                                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                                        </ControlTheme>
                                                    </MenuFlyout.ItemContainerTheme>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>

                                        <!-- Clear Terminal Button (when Terminal tab active) -->
                                        <Button Background="Transparent" Padding="5" 
                                                Command="{Binding BottomPanel.ClearTerminalCommand}" 
                                                ToolTip.Tip="Clear Terminal (Ctrl+L)"
                                                IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=0}">
                                            <Path Data="{StaticResource IconClear}" Width="11" Height="11" Fill="#858585" Stretch="Uniform" />
                                        </Button>

                                        <!-- Clear Debug Console Button (when Debug Console tab active) -->
                                        <Button Background="Transparent" Padding="5" 
                                                Command="{Binding BottomPanel.DebugConsole.ClearCommand}" 
                                                ToolTip.Tip="Clear Debug Console"
                                                IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=3}">
                                            <Path Data="{StaticResource IconClear}" Width="11" Height="11" Fill="#858585" Stretch="Uniform" />
                                        </Button>

                                        <!-- Open External Terminal Button -->
                                        <Button Background="Transparent" Padding="5" Command="{Binding BottomPanel.OpenExternalAlacrittyCommand}" ToolTip.Tip="Open in External Terminal">
                                            <Path Data="{StaticResource IconTerminal}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                                        </Button>

                                        <!-- Close Panel Button -->
                                        <Button Background="Transparent" Padding="5" Command="{Binding BottomPanel.CloseCommand}" ToolTip.Tip="Close Panel (Ctrl+J)">
                                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Fill="#858585" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Panel Content (Tab Switcher with Direct Dynamic Sizing) -->
                            <Grid Grid.Row="1">
                                <!-- 1. Interactive Terminal Canvas + Right-Side Active Instances Pane -->
                                <Grid ColumnDefinitions="*,Auto,200"
                                      IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=0}">
                                    <!-- Main Interactive Terminal Canvas -->
                                    <views:TerminalCanvas Grid.Column="0"
                                                          x:Name="TerminalCanvasControl"
                                                          Terminal="{Binding BottomPanel.TerminalSession}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch" />

                                    <!-- Splitter / Separator Border -->
                                    <GridSplitter Grid.Column="1" Width="3" Background="{StaticResource PanelBorderBrush}" ResizeDirection="Columns" Cursor="SizeWestEast" />

                                    <!-- Right-Side Vertical Active Terminal Instances Pane (ONLY Active Instances) -->
                                    <Border Grid.Column="2" MinWidth="130" MaxWidth="500" Background="{StaticResource SideBarBackgroundColor}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
                                        <Grid RowDefinitions="28,*">
                                            <!-- Header with Title & Quick Action -->
                                            <Border Grid.Row="0" Height="28" Padding="10,0,6,0" Background="{StaticResource TitleBarBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="OPEN TERMINALS" FontSize="10" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Background="Transparent" Padding="4" Command="{Binding BottomPanel.CreateTerminalTabCommand}" ToolTip.Tip="New Default Terminal (Ctrl+Shift+`)">
                                                        <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Fill="#CCCCCC" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Vertically Stacked Open Terminal Instances List -->
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding BottomPanel.TerminalTabs}" Margin="0,3,0,3">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TerminalTabItem}">
                                                            <Button Background="{Binding IsActive, Converter={x:Static views:TerminalTabActiveBackgroundConverter.Instance}}"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                    Padding="8,5" Margin="3,1" CornerRadius="3" BorderThickness="0"
                                                                    Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).BottomPanel.SelectTerminalTabCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    PointerPressed="OnTerminalTabItemPointerPressed">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <Path Grid.Column="0" Data="{StaticResource IconTerminal}" Width="11" Height="11" Fill="#9CDCFE" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="{Binding IsActive, Converter={x:Static views:TabForegroundConverter.Instance}, ConverterParameter=1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2" Background="Transparent" Padding="3" BorderThickness="0"
                                                                            Command="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).BottomPanel.CloseTerminalTabCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Kill Terminal">
                                                                        <Path Data="{StaticResource IconClose}" Width="8" Height="8" Fill="#858585" Stretch="Uniform" />
                                                                    </Button>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 2. Build Output View -->
                                <ScrollViewer Margin="8"
                                              IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=1}">
                                    <TextBlock Text="{Binding BottomPanel.BuildOutput}" 
                                               FontFamily="Cascadia Code, Consolas, Courier New, monospace" 
                                               FontSize="12" 
                                               Foreground="#9CDCFE" />
                                </ScrollViewer>

                                <!-- 3. Problems View -->
                                <ListBox ItemsSource="{Binding BottomPanel.Problems}" 
                                         Background="Transparent" 
                                         Margin="4"
                                         IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=2}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProblemItem}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                                                <Path Grid.Column="0" Data="{StaticResource IconError}" Width="12" Height="12" Fill="{Binding Color}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="13" Foreground="#D4D4D4" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding File, StringFormat='{}{0}'}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 4. Debug Console REPL View -->
                                <Grid RowDefinitions="*,Auto" Margin="8,4"
                                      IsVisible="{Binding BottomPanel.SelectedTabIndex, Converter={x:Static views:TabWeightConverter.Instance}, ConverterParameter=3}">
                                    <!-- Messages Stream List -->
                                    <ScrollViewer Grid.Row="0">
                                        <ItemsControl ItemsSource="{Binding BottomPanel.DebugConsole.Messages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:DebugConsoleMessage}">
                                                    <TextBlock Text="{Binding Text}" 
                                                               FontFamily="Cascadia Code, Consolas, Courier New, monospace" 
                                                               FontSize="12"
                                                               Foreground="#D4D4D4"
                                                               Margin="2,1"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- REPL Expression Input Box -->
                                    <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="&gt; " FontFamily="Cascadia Code, Consolas, monospace" FontSize="13" Foreground="#4EC9B0" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Grid.Column="1" Text="{Binding BottomPanel.DebugConsole.InputExpression, Mode=TwoWay}"
                                                     Watermark="Evaluate expression in debug context..."
                                                     Background="Transparent" BorderThickness="0"
                                                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                                                     Foreground="White" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Evaluate" Background="#0078D4" Foreground="White" FontSize="10" Padding="8,3" CornerRadius="2"
                                                    Command="{Binding BottomPanel.DebugConsole.ExecuteReplCommand}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>

            <!-- ========================================================================= -->
            <!-- 3. STATUS BAR (22px)                                                      -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2" Background="{StaticResource StatusBarBackgroundBrush}" Height="22">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Remote badge + Branch + Errors/Warnings -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Remote Connection Button -->
                        <Button Background="{StaticResource StatusBarRemoteBackgroundBrush}" 
                                BorderThickness="0" CornerRadius="0"
                                Padding="8,0" Height="22"
                                Command="{Binding SelectActivityCommand}"
                                CommandParameter="6"
                                ToolTip.Tip="Open Remote Explorer / Manage Remote Sessions">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRemote}" Width="13" Height="13" Fill="White" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RemoteExplorer.ActiveTargetTitle}" FontSize="11" Foreground="White" FontWeight="SemiBold"
                                           IsVisible="{Binding RemoteExplorer.IsConnected}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Open Remote Explorer" Command="{Binding SelectActivityCommand}" CommandParameter="6" />
                                    <MenuItem Header="Open SSH Config (~/.ssh/config)" Command="{Binding RemoteExplorer.OpenSshConfigFileCommand}" />
                                    <MenuItem Header="Forward a Port..." Command="{Binding RemoteExplorer.OpenPortForwardDialogCommand}" />
                                    <Separator />
                                    <MenuItem Header="Close Remote Connection" Command="{Binding RemoteExplorer.DisconnectCommand}" IsVisible="{Binding RemoteExplorer.IsConnected}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBranch}" Width="12" Height="12" Fill="White" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GitBranch}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconError}" Width="11" Height="11" Fill="White" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BottomPanel.ErrorCount}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconWarning}" Width="11" Height="11" Fill="White" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BottomPanel.WarningCount}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Status Message -->
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="White" Margin="20,0" VerticalAlignment="Center" />

                    <!-- Right: Server Controls & Editor Info -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="0,0,10,0" VerticalAlignment="Center">
                        <!-- Language Server Indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="Language Server Protocol Status">
                            <Path Data="{StaticResource IconCheck}" Width="10" Height="10" Fill="#75BEFF" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveLanguageServerText}" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Host Local Server Button -->
                        <Button Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="3"
                                Command="{Binding HostLocalServerCommand}"
                                ToolTip.Tip="Host Local Server (Flask/FastAPI/Node/Vite)">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Width="11" Height="11" 
                                      Fill="{Binding IsLocalServerRunning, Converter={x:Static views:BooleanBrushConverter.Instance}}" 
                                      Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LocalServerStatusText}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Go Live / Live Server Button -->
                        <Button Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="3"
                                Command="{Binding ToggleLiveServerCommand}"
                                ToolTip.Tip="Toggle Built-in Live Server (:5500)">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLink}" Width="11" Height="11" 
                                      Fill="{Binding IsLiveServerRunning, Converter={x:Static views:BooleanBrushConverter.Instance}}" 
                                      Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LiveServerStatusText}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="12" Fill="#454545" VerticalAlignment="Center" Margin="2,0" />

                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CursorLine, StringFormat='{}Ln {0}'}" FontSize="11" Foreground="White" />
                            <TextBlock Text="{Binding CursorCol, StringFormat=', Col {0}'}" FontSize="11" Foreground="White" />
                            <TextBlock Text="{Binding SelectionStatus}" FontSize="11" Foreground="White" />
                        </StackPanel>
                        <TextBlock Text="Spaces: 4" FontSize="11" Foreground="White" />
                        <TextBlock Text="UTF-8" FontSize="11" Foreground="White" />
                        <TextBlock Text="CRLF" FontSize="11" Foreground="White" />
                        <TextBlock Text="{Binding SelectedTab.Language, FallbackValue='Plain Text'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Floating Command Palette / Quick Open Overlay Modal -->
        <views:CommandPaletteOverlay DataContext="{Binding CommandPalette}" />
    </Grid>
</Window>
