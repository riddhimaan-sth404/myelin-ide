<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Myelin.UI.Views"
             x:Class="Myelin.UI.Views.MarkdownPreviewView">

    <Grid RowDefinitions="36,*">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Path Data="{StaticResource IconExplorer}" Width="14" Height="14" Fill="#38BDF8" Stretch="Uniform" />
                    <TextBlock Text="Markdown Preview" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Click="OnOpenInBrowserClicked"
                            Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="3"
                            ToolTip.Tip="Open in Default Browser">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{StaticResource IconLink}" Width="12" Height="12" Fill="#858585" Stretch="Uniform" />
                            <TextBlock Text="Open in Browser" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Preview Body Container -->
        <Border Grid.Row="1" Background="#1E1E1E">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <SelectableTextBlock x:Name="PreviewTextBlock"
                                     FontSize="13"
                                     Foreground="#D4D4D4"
                                     TextWrapping="Wrap"
                                     LineHeight="22" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
